{
  "name": "smartgarden-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "test:e2e:debug": "node tests/e2e/helpers/debug-setup.js",
    "dev:api": "node dev-server.js",
    "dev:client": "vite",
    "dev:watch": "concurrently \"npm run dev\" \"npm run test:watch\"",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "playwright": "playwright",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:ci && npm run test:e2e",
    "test:ui": "vitest --ui",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "test-storybook",
    "playwright:install": "playwright install",
    "playwright:install:chromium": "playwright install chromium",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:chromium:ui": "playwright test --project=chromium --ui",
    "test:storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npm run build-storybook --quiet\" \"wait-on tcp:6006 && npm run test:storybook\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tanstack/react-query": "^5.80.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "firebase": "^11.9.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.6.2",
    "tailwind-merge": "^3.3.1",
    "ts-node": "^10.9.2",
    "util": "^0.12.5",
    "uuid": "^11.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "workbox-window": "^7.3.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "^9.1.7",
    "@storybook/addon-docs": "^9.1.7",
    "@storybook/addon-onboarding": "^9.1.7",
    "@storybook/addon-vitest": "^9.1.7",
    "@storybook/react-vite": "^9.1.7",
    "@storybook/test-runner": "^0.23.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^9.1.7",
    "express": "^4.21.2",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^27.0.0",
    "msw": "^2.11.2",
    "msw-storybook-addon": "^2.0.5",
    "playwright": "^1.55.0",
    "postcss": "^8.5.5",
    "storybook": "^9.1.7",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1",
    "whatwg-fetch": "^3.6.20"
  }
}
